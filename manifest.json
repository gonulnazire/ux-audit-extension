{
  "manifest_version": 3,
  "name": "UX & Accessibility Audit Tool",
  "version": "1.0.0",
  "description": "Deterministik kurallarla web sayfaları için erişilebilirlik denetim aracı.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
    
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.anthropic.com"
  }
}